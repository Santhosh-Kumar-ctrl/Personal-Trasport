# Copy to backend/.env and adjust. Defaults work with docker-compose.yml as-is.
# This file is for DEVELOPMENT. For production use deploy/.env.prod.example (see docs/DEPLOY.md).
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://transit:transit@localhost:5433/transit
TEST_DATABASE_URL=postgresql+asyncpg://transit:transit@localhost:5433/transit_test

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Demos: lets admins send explicit arrival times and replay GPS (scripts.demo_scenario and
# scripts.simulate_reports need it). Never in production; it defaults to false.
ALLOW_SIMULATION=true

# Boarding QR rotates every N seconds; a token is valid for QR_TTL_SECONDS
QR_TTL_SECONDS=30

# Operational thresholds
DELAY_THRESHOLD_MIN=5
# A late trip is announced again only when it crosses the next step (minutes late), then never
# again. Steps above DELAY_STUDENT_ALERT_MAX_MIN reach the transport office only.
DELAY_ALERT_STEPS=5,15,30,60
DELAY_STUDENT_ALERT_MAX_MIN=30
CAPACITY_WARN_PCT=90
DELAY_WATCH_INTERVAL_SECONDS=60

# Comma-separated origins allowed to call the API (Flutter web dev server)
CORS_ORIGINS=*

# Live tracking: auto-arrival radius, "bus is near" radius, worst GPS accuracy that may trigger either
ARRIVAL_RADIUS_M=100
APPROACH_RADIUS_M=2000
MAX_FIX_ACCURACY_M=100

# Rate limits (per API process)
LOGIN_ATTEMPTS_PER_MINUTE=10
REPORTS_PER_HOUR=5

# Housekeeping: GPS fixes and read notifications older than this are deleted
POSITION_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=180

# Student reports: REPORT_AI=rules (default) keeps analysis local. REPORT_AI=nim sends report text
# to NIM_BASE_URL (NVIDIA's hosted API by default) and needs NIM_API_KEY; falls back to rules on error.
REPORT_AI=rules
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NIM_TIMEOUT_SECONDS=30
# response_format=json_object; off because Nemotron 3 returns broken JSON in that mode
NIM_JSON_MODE=false
REPORT_SPEED_LIMIT_KMPH=60
REPORT_LOOKBACK_DAYS=3
